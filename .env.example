# Copie para .env (NUNCA commite). Gere segredos com: npm run gen-secrets
NODE_ENV=production
PORT=3000
BASE_URL=https://seu-dominio.com.br
TRUST_PROXY=true

# Chave-mestra (base64, 32+ bytes). Deriva as chaves de cifra de dados, QR dos ingressos, auditoria e 2FA.
# GUARDE UM BACKUP EM COFRE: perdê-la = perder acesso aos dados pessoais cifrados.
MASTER_KEY=

# Banco SQLite (faça backup diário do arquivo + da MASTER_KEY, em locais separados)
DB_PATH=data/terra-dos-canions.db

# Pagamentos — Mercado Pago (use credenciais TEST- até validar tudo)
PAYMENT_PROVIDER=mercadopago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# E-mail transacional (opcional, mas recomendado): smtps://usuario:senha@smtp.exemplo.com:465
SMTP_URL=
MAIL_FROM="Terra dos Cânions <ingressos@seu-dominio.com.br>"

# Ajustes
ORDER_HOLD_MINUTES=15
MAX_TICKETS_PER_ORDER=10
RETENTION_DAYS=365
REQUIRE_TOTP=true
