# ──────────────────────────────────────────────────────────────────────────────
# Cambará Ornamentais — variáveis de ambiente
# Copie para .env.local (dev) e cadastre as mesmas na Vercel (produção).
# Tudo que começa com NEXT_PUBLIC_ é visível no navegador: nunca coloque segredos nelas.
# Sem DATABASE_URL o site roda em "modo demonstração" (catálogo estático, checkout/admin desativados).
# ──────────────────────────────────────────────────────────────────────────────

# URL pública do site (sem barra no final). Usada em sitemap, e-mails e webhook do Mercado Pago.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (Auth + Storage + PostgreSQL) ────────────────────────────────────
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOMENTE servidor (upload de fotos, script admin:create). Nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=
# Settings → Database → Connection string
# DATABASE_URL: pooler (porta 6543) — usado pelo app em produção (serverless)
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: conexão direta (porta 5432) — usada por prisma db push / migrate
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Mercado Pago (Checkout Transparente: Pix, cartão, boleto) ────────────────
# Sandbox: credenciais de TESTE ("TEST-..."). Produção: credenciais de produção ("APP_USR-...").
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Chave secreta do webhook (Suas integrações → Webhooks → "Chave secreta"). Obrigatória: sem ela o webhook recusa tudo.
MERCADOPAGO_WEBHOOK_SECRET=

# ── Frete: Melhor Envio (opcional — sem token usa a tabela fixa por região) ──
MELHOR_ENVIO_TOKEN=
# sandbox | production
MELHOR_ENVIO_ENV=sandbox
# IDs de serviços: 1 PAC, 2 SEDEX, 3 .Package (Jadlog), 4 .Com (Jadlog)... (https://docs.melhorenvio.com.br)
MELHOR_ENVIO_SERVICES=1,2,3,4
# E-mail técnico exigido no User-Agent da API do Melhor Envio
MELHOR_ENVIO_CONTACT_EMAIL=contato@seudominio.com.br
# CEP de origem (só dígitos). Também editável no admin → Configurações.
ORIGIN_CEP=00000000

# ── E-mails transacionais: Resend ─────────────────────────────────────────────
RESEND_API_KEY=
# Remetente com domínio verificado no Resend
EMAIL_FROM="Cambará Ornamentais <pedidos@seudominio.com.br>"

# ── Dados da loja (substitua os [COLCHETES] do briefing) ──────────────────────
# WhatsApp que recebe os pedidos (só dígitos com DDI+DDD): +55 54 99919-7178
NEXT_PUBLIC_WHATSAPP=5554999197178
# @ do Instagram, sem o @
NEXT_PUBLIC_INSTAGRAM=cambaraornamentais
NEXT_PUBLIC_CNPJ=00.000.000/0000-00
NEXT_PUBLIC_CONTACT_EMAIL=contato@seudominio.com.br
NEXT_PUBLIC_PICKUP_ADDRESS="Rua Exemplo, 123 — Cidade/UF"
# URL de incorporação (iframe src) do Google Maps/OpenStreetMap para a página de contato (opcional)
NEXT_PUBLIC_MAP_EMBED_URL=

# ── Analytics (carregam somente após o consentimento de cookies) ─────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Rate limiting distribuído (opcional; recomendado na Vercel) ──────────────
# Sem isto o limite é em memória, por instância. Crie um banco grátis em upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Somente para `npm run admin:create` (não cadastre na Vercel) ─────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administração
